{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monmenu-public",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",

  // D1 Database principale
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monmenu-production",
      "database_id": "REPLACE_WITH_ACTUAL_D1_ID"
    }
  ],

  // KV pour cache (menus, config globale)
  "kv_namespaces": [
    {
      "binding": "KV_CACHE",
      "id": "REPLACE_WITH_KV_ID",
      "preview_id": "REPLACE_WITH_KV_PREVIEW_ID"
    }
  ],

  // R2 pour les médias (logos, photos plats)
  "r2_buckets": [
    {
      "binding": "R2_MEDIA",
      "bucket_name": "monmenu-media"
    }
  ]
}
