{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monmenu",
  "main": "./dist/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],

  // Assets statiques (favicon, css, js, images) — servis directement par Cloudflare
  // avant même d'atteindre le Worker (plus rapide que serveStatic dans Hono)
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monmenu-production",
      "database_id": "REPLACE_WITH_ACTUAL_D1_ID"
    }
  ],

  "r2_buckets": [
    {
      "binding": "R2_MEDIA",
      "bucket_name": "monmenu-media"
    }
  ]
}