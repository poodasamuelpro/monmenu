{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monmenu",
  "main": "./dist/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],

  // Assets statiques (favicon, css, js, images) — servis directement par Cloudflare
  // avant même d'atteindre le Worker (plus rapide que serveStatic dans Hono)
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monmenu-production",
      "database_id": "661ff0a6-172f-4ed1-a101-fb4b8c7cae22"
    }
  ],

  "r2_buckets": [
    {
      "binding": "R2_MEDIA",
      "bucket_name": "monmenu-media"
    }
  ],

  // §1.8 — Cron trigger : calcul des stats journalières à 02h00 UTC chaque nuit
  "triggers": {
    "crons": ["0 2 * * *"]
  }
}
