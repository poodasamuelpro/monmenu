{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monmenu",
  "main": "./dist/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],

  // Assets statiques (favicon, css, js, images) — servis directement par Cloudflare
  // avant même d'atteindre le Worker (plus rapide que serveStatic dans Hono)
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monmenu-production",
      "database_id": "661ff0a6-172f-4ed1-a101-fb4b8c7cae22"
    }
  ],

  "r2_buckets": [
    {
      "binding": "R2_MEDIA",
      "bucket_name": "monmenu-media"
    }
  ],

  // A-03 (BUG-08/S4-01/S9-04) — KV_CACHE : rate limiting distribué + cache boutique + sitemap.
  // Binding absent → rate limiting en Map mémoire locale par isolate (non distribué),
  // cache boutique/home désactivé (plans/screenshots/logos ne se chargent pas).
  // IMPORTANT : lier ce namespace dans le dashboard Cloudflare Workers > KV après création :
  //   npx wrangler kv namespace create monmenu-cache
  // Puis remplacer "REMPLACER_PAR_ID_REEL" par l'id retourné.
  "kv_namespaces": [
    {
      "binding": "KV_CACHE",
      "id": "21083c6b049349aca60411d19c8aeaba"
    }
  ],

  // §1.8 CYCLE-6 — Passage de 7 à 5 cron triggers (limite plan Free
  // Cloudflare : 5 max par compte). Détail des fusions dans api-cron.ts.
  "triggers": {
    // crons (heures UTC) :
    //   "0 2 * * *"    → stats journalières (isolée : seule tâche à calcul CPU synchrone)
    //   "10 2 * * *"   → tenants expirés (essais → inactif ET abonnements → inactif, FUSIONNÉS)
    //   "20 2 * * *"   → capture screenshots boutique (isolée : dépendance externe thum.io)
    //   "30 */6 * * *" → blocage paiements en_attente_confirmation expirés (isolée : la plus sensible)
    //   "0 8 * * *"    → rappels J-5 ET J-2 (FUSIONNÉS, anciennement 08h + 09h séparés)
    "crons": ["0 2 * * *", "10 2 * * *", "20 2 * * *", "30 */6 * * *", "0 8 * * *"]
  },

  // Variables non sensibles — PUBLIC_BASE_URL utilisée par le cron pour
  // savoir quelle URL capturer (lib/screenshot.ts).
  // CORRIGÉ 2026-07-30 — pointée vers l'URL workers.dev actuelle tant que
  // le domaine définitif monmenu.com n'est pas acheté et branché en production.
  // À remettre sur "https://monmenu.com" une fois le domaine final actif
  // (voir la procédure : Cloudflare DNS + Custom Domain sur le Worker +
  // authentification du domaine côté Brevo).
  "vars": {
    "PUBLIC_BASE_URL": "https://monmenu.poodasamuelpro.workers.dev"
  },

  // Logs d'observabilité Cloudflare (Observability > Logs dans le dashboard)
  // pour voir les erreurs runtime en direct, y compris les invocations complètes.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}