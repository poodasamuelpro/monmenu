{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monmenu",
  "main": "./dist/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],

  // Assets statiques (favicon, css, js, images) — servis directement par Cloudflare
  // avant même d'atteindre le Worker (plus rapide que serveStatic dans Hono)
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monmenu-production",
      "database_id": "661ff0a6-172f-4ed1-a101-fb4b8c7cae22"
    }
  ],

  "r2_buckets": [
    {
      "binding": "R2_MEDIA",
      "bucket_name": "monmenu-media"
    }
  ],

  // §1.8 — Cron triggers : 4 tâches séparées pour isoler leur
  // budget de temps et leurs logs (voir api-cron.ts) :
  //   02h00 UTC → calcul des stats journalières
  //   02h10 UTC → vérification des essais expirés (essai → inactif)
  //   02h20 UTC → capture des screenshots boutique (thum.io → R2)
  //   toutes les 6h à :30 → blocage automatique paiements expirés (72h window)
  "triggers": {
    "crons": ["0 2 * * *", "10 2 * * *", "20 2 * * *", "30 */6 * * *"]
  },

  // Variables non sensibles — PUBLIC_BASE_URL utilisée par le cron pour
  // savoir quelle URL capturer (lib/screenshot.ts). Ajuste-la si ton
  // domaine définitif diffère.
  "vars": {
    "PUBLIC_BASE_URL": "https://monmenu.app"
  },

  // Logs d'observabilité Cloudflare (Observability > Logs dans le dashboard)
  // pour voir les erreurs runtime en direct, y compris les invocations complètes.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
