{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monmenu-public",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",

  // D1 Database principale (auto-provisionnée par gsk hosted deploy)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monmenu-production",
      "database_id": "REPLACE_WITH_ACTUAL_D1_ID"
    }
  ],

  // R2 pour les médias (logos, photos plats) — auto-provisionnée
  "r2_buckets": [
    {
      "binding": "R2_MEDIA",
      "bucket_name": "monmenu-media"
    }
  ]
}
