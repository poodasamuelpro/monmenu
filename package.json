{
  "name": "monmenu-public",
  "version": "1.0.0",
  "type": "module",
  "description": "MonMenu - Plateforme de commande en ligne pour restaurants - Afrique de l'Ouest et Centrale",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name monmenu-public",
    "deploy:prod": "npm run build && wrangler pages deploy dist --project-name monmenu-public",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply monmenu-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply monmenu-production",
    "db:seed": "wrangler d1 execute monmenu-production --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "hono": "^4.12.31",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260714.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-cloudflare-pages": "^0.4.3",
    "@hono/vite-dev-server": "^0.26.1",
    "typescript": "^5.8.0",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
